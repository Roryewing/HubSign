HOST=sign.example.com
SECRET_KEY_BASE=            # openssl rand -hex 64
# Supabase > Connect > Session pooler (port 5432, NOT the transaction pooler on 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase > Storage > S3 connection: private bucket + access keys
S3_ATTACHMENTS_BUCKET=hubsign
S3_ENDPOINT=https://PROJECTREF.storage.supabase.co/storage/v1/s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
