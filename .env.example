# Public URL of this deployment. Signing links in emails and API responses are built from it.
HUBSIGN_BASE_URL=http://localhost:8000
# Where the SQLite database and (without S3) the PDFs live. Put this on a persistent disk.
HUBSIGN_DATA_DIR=data
# Several nodes: use PostgreSQL and S3-compatible storage.
HUBSIGN_DATABASE_URL=
# Keep PDFs in the database (no disk or bucket needed; for free hosts).
HUBSIGN_DOCUMENTS_IN_DATABASE=false
HUBSIGN_S3_BUCKET=
HUBSIGN_S3_PREFIX=
HUBSIGN_S3_ENDPOINT_URL=
HUBSIGN_S3_REGION=
# Number of reverse proxies in front (Render, nginx, a load balancer = 1). Required for correct IPs and rate limits.
HUBSIGN_TRUST_PROXY_HOPS=0
# Session-cookie and one-time-code secret. Leave blank to generate one into the data directory.
HUBSIGN_SECRET=
# The very first account is always allowed. Set false afterwards to close registration (invitations still work).
# Reserve the very first account for this address, so nobody can claim a new public server before you.
HUBSIGN_FIRST_USER_EMAIL=
HUBSIGN_ALLOW_SIGNUP=true
# Only for local development: allow webhooks to call localhost / private addresses.
HUBSIGN_ALLOW_PRIVATE_WEBHOOKS=false
# Cryptographic seal. Blank = a self-signed certificate is generated. Bring your own for a trusted signer in Acrobat.
HUBSIGN_SEAL_CERT_FILE=
HUBSIGN_SEAL_KEY_FILE=
HUBSIGN_SEAL_CHAIN_FILE=
HUBSIGN_SEAL_KEY_PASSWORD=
# RFC 3161 timestamp authority, e.g. http://timestamp.digicert.com
HUBSIGN_TSA_URL=
# SMS one-time codes (Twilio)
HUBSIGN_TWILIO_SID=
HUBSIGN_TWILIO_TOKEN=
HUBSIGN_TWILIO_FROM=
# Email delivery of signing requests and email codes. SendGrid API (preferred) or SMTP.
HUBSIGN_SENDGRID_API_KEY=
HUBSIGN_MAIL_FROM=
HUBSIGN_MAIL_FROM_NAME=HubSign
HUBSIGN_SMTP_HOST=
HUBSIGN_SMTP_PORT=587
HUBSIGN_SMTP_USER=
HUBSIGN_SMTP_PASSWORD=
HUBSIGN_SMTP_FROM=
