# Public URL of this deployment. Signing links in emails and API responses are built from it.
HUBSIGN_BASE_URL=http://localhost:8000
# Where the SQLite database and PDFs live. Put this on a persistent disk.
HUBSIGN_DATA_DIR=data
# Session-cookie signing secret. Leave blank to generate one into the data directory.
HUBSIGN_SECRET=
# The very first account is always allowed. Set false afterwards to close registration.
HUBSIGN_ALLOW_SIGNUP=true
# Only for local development: allow webhooks to call localhost / private addresses.
HUBSIGN_ALLOW_PRIVATE_WEBHOOKS=false
# Optional email delivery of signing requests. Without it, use the signing_url from the API.
HUBSIGN_SMTP_HOST=
HUBSIGN_SMTP_PORT=587
HUBSIGN_SMTP_USER=
HUBSIGN_SMTP_PASSWORD=
HUBSIGN_SMTP_FROM=
